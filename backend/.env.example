# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# CORS configuration (comma separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173

# Optional Application Configuration
PORT=8000
HOST=0.0.0.0

# Gemini Model Name (e.g. gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Rate limiting (per client IP, slowapi syntax)
RATE_LIMIT_ENABLED=true
GENERATE_RATE_LIMIT=5/minute;30/hour
CHAT_RATE_LIMIT=20/minute

# Generated attractions farther than this from the destination are dropped
MIN_ATTRACTION_RADIUS_KM=50
